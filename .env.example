# ==============================================================================
# Coralink API - Modelo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com seus valores reais
# ==============================================================================

# Perfil ativo do Spring Boot (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Chave secreta HMAC-SHA256 para assinatura de tokens JWT (Obrigatório - mínimo 256 bits)
JWT_SECRET=sua-chave-secreta-jwt-de-no-minimo-256-bits-gerada-com-seguranca

# Google AI Studio (Gemini Flash)
GEMINI_API_KEY=sua_chave_do_google_ai_studio_aqui

# Google OAuth2 Client ID (Para login social com Google)
GOOGLE_CLIENT_ID=seu_client_id_google_oauth2_aqui.apps.googleusercontent.com

# Banco de Dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/coralink
DB_USERNAME=coralink
DB_PASSWORD=coralink

# Cache Distribuído (Redis / Upstash)
# No Upstash, você pode fornecer a UPSTASH_REDIS_REST_URL ou a string REDIS_URL
# REDIS_URL=rediss://default:sua_senha@seu-host.upstash.io:6379
# UPSTASH_REDIS_REST_URL=https://seu-host.upstash.io
# UPSTASH_REDIS_REST_TOKEN=seu_token_aqui

# Token Storyblok CDN (Porto Digital - opcional)
PORTO_DIGITAL_STORYBLOK_TOKEN=seu_token_publico_storyblok_aqui

# CORS - Origens Permitidas no Frontend (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://coralink.vercel.app

# Rate Limiting por IP (Requisições por minuto - Padrão: 120)
RATE_LIMIT_CAPACITY=120
